{
  "default_user": "alex_noogler",
  "model": {
    "name": "gemini-2.5-flash-lite",
    "temperature": 0.1
  },
  "model_routing": {
    "enabled": true,
    "capable_model": "gemini-2.5-flash"
  },
  "compaction": {
    "enabled": true,
    "async_background": true,
    "first_n_messages": 6,
    "model_name": null,
    "interval": 5,
    "overlap_size": 1,
    "token_threshold": 8000,
    "event_retention_size": 2
  },
  "logging": {
    "level": "INFO"
  },
  "otel": {
    "service_name": "fde-duckie",
    "exporter": "none"
  },
  "database": {
    "backend": "sqlite",
    "url": "sqlite:///data/fde_duckie.db"
  },
  "secrets": {
    "backend": "vault",
    "vault_addr": "http://127.0.0.1:8200",
    "vault_mount": "secret",
    "vault_path": "fde-duckie",
    "vault_namespace": null,
    "gcp_project_id": null
  },
  "pii": {
    "enabled": true
  },
  "security": {
    "model_armor": {
      "enabled": false,
      "prompt_template_name": null,
      "response_template_name": null
    }
  }
}
