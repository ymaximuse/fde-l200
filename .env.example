# Model configuration (defaults to Gemini Flash-Lite)
FDE_DUCKIE_MODEL=gemini-2.5-flash-lite
# Optional default mock persona: alex_noogler | priya_fde | jordan_fde
# FDE_DUCKIE_DEFAULT_USER=alex_noogler

# ADK Context Compaction (defaults keep multi-turn context lean for Flash-Lite)
# FDE_DUCKIE_COMPACTION_ENABLED=true
# FDE_DUCKIE_COMPACTION_MODEL=gemini-2.5-flash-lite
# FDE_DUCKIE_COMPACTION_INTERVAL=5
# FDE_DUCKIE_COMPACTION_OVERLAP=1
# FDE_DUCKIE_COMPACTION_TOKEN_THRESHOLD=8000
# FDE_DUCKIE_COMPACTION_RETENTION_SIZE=2

# Google AI Studio
GOOGLE_API_KEY=your-api-key-here

# Or Vertex AI (uncomment and run `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
