# HashiCorp Vault local dev connection (default secrets.backend="vault")
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token

# Fallback credentials if not using Vault (or set secrets.backend="env" in config.json)
# GOOGLE_API_KEY=your-api-key-here

# Or Vertex AI (uncomment and run `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: point `adk run agent` / `adk web` to a JSON config file
# FDE_DUCKIE_CONFIG=config.json

# Optional: standard OTLP endpoint when otel.exporter="otlp" in your JSON config
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
